            },

            printStockIssue(issueId) {
                const iss = AppState.issues.find(i => i.id === issueId);
                if (!iss) return;

                this.updatePrintHeader();
                document.getElementById('print-doc-title').innerText = 'إذن صرف مخزني';
                document.getElementById('print-doc-number').innerText = iss.issue_number;
                document.getElementById('print-doc-date').innerText = iss.issue_date;

                // Party Info
                document.getElementById('print-party-box-title').innerText = 'بيانات جهة / مسؤول الاستلام';
                document.getElementById('print-party-name').innerText = iss.recipient_name;
                document.getElementById('print-party-phone-row').style.display = 'none';
                document.getElementById('print-party-addr-row').style.display = 'none';

                // Operation Meta
                document.getElementById('print-meta-op-type').innerText = 'صرف بضاعة من المخزن';
                document.getElementById('print-meta-status').innerText = iss.status === 'approved' ? 'معتمد وخصم من رصيد المخزن' : 'مسودة إذن صرف';
                document.getElementById('print-meta-creator').innerText = 'سبب الصرف: ' + iss.reason;

                const thead = document.getElementById('print-table-head');
                thead.innerHTML = '<tr>' +
                    '<th style="width: 35px;">م</th>' +
                    '<th style="width: 110px;">كود الصنف</th>' +
                    '<th>اسم الصنف المنصرف</th>' +
                    '<th style="width: 70px;">الوحدة</th>' +
                    '<th style="width: 80px;">الكمية المنصرفة</th>' +
                    '<th>ملاحظات الصرف والبيان</th>' +
                '</tr>';

                const tbody = document.getElementById('print-table-body');
                tbody.innerHTML = (iss.items || []).map((it, idx) => {
                    const prod = AppState.products.find(p => p.id === it.product_id);
                    return '<tr>' +
                        '<td class="text-center">' + (idx + 1) + '</td>' +
                        '<td class="text-center"><strong>' + (prod ? prod.sku : '') + '</strong></td>' +
                        '<td><strong>' + (prod ? prod.name : '') + '</strong></td>' +
                        '<td class="text-center">' + (prod ? prod.unit : '') + '</td>' +
                        '<td class="text-center"><strong>' + formatQty(it.quantity) + '</strong></td>' +
                        '<td>' + (iss.reason || '--') + '</td>' +
                    '</tr>';
                }).join('');

                document.getElementById('print-totals-table').style.display = 'none';
                document.getElementById('print-tafqeet-container').style.display = 'none';
                document.getElementById('print-notes-text').innerText = iss.notes || ('الغرض من الصرف: ' + iss.reason + ' - تم تسليم البضاعة كاملة وبحالة جيدة.');

                // Signatures
                document.getElementById('print-sign-title-1').innerText = 'توقيع المستلم الفعلي';
                document.getElementById('print-sign-name-1').innerText = 'السيد: ' + iss.recipient_name;
                document.getElementById('print-sign-title-2').innerText = 'أمين المخزن المنفذ';
                document.getElementById('print-sign-title-3').innerText = 'اعتماد إدارة المخازن';

                window.print();
            }
        };

        // Initialize application when DOM is loaded
        window.addEventListener('DOMContentLoaded', () => {
            App.init();
        });
    </script>
</body>
</html>