    <script>
        /**
         * Safe Financial Rounding Helper (2 decimals)
         */
        function round2(val) {
            return Math.round((Number(val) + Number.EPSILON) * 100) / 100;
        }

        /**
         * Safe Quantity Formatter (displays whole numbers cleanly and up to 3 decimals without trailing zeroes)
         */
        function formatQty(val) {
            if (val === null || val === undefined || isNaN(val) || val === '') return '0';
            const num = Number(val);
            if (num % 1 === 0) return num.toString();
            return Number(num.toFixed(3)).toString();
        }

        /**
         * Egyptian Pound Tafqeet Helper (Convert Currency Number to Arabic Words)
         */
        function tafqeetArabic(amount) {
            if (amount === null || amount === undefined || isNaN(amount) || Number(amount) === 0) return 'صفر جنيه مصري لا غير';
            const numAmount = Number(amount);
            const ones = ['', 'واحد', 'اثنان', 'ثلاثة', 'أربعة', 'خمسة', 'ستة', 'سبعة', 'ثمانية', 'تسعة', 'عشرة',
                'أحد عشر', 'اثنا عشر', 'ثلاثة عشر', 'أربعة عشر', 'خمسة عشر', 'ستة عشر', 'سبعة عشر', 'ثمانية عشر', 'تسعة عشر'];
            const tens = ['', '', 'عشرون', 'ثلاثون', 'أربعون', 'خمسون', 'ستون', 'سبعون', 'ثمانون', 'تسعون'];
            const hundreds = ['', 'مائة', 'مائتان', 'ثلاثمائة', 'أربعمائة', 'خمسمائة', 'ستمائة', 'سبعمائة', 'ثمانمائة', 'تسعمائة'];
            
            function convertGroup(n) {
                if (n === 0) return '';
                let res = '';
                const h = Math.floor(n / 100);
                const rem = n % 100;
                if (h > 0) res += hundreds[h];
                if (rem > 0) {
                    if (res) res += ' و';
                    if (rem < 20) {
                        res += ones[rem];
                    } else {
                        const o = rem % 10;
                        const t = Math.floor(rem / 10);
                        if (o > 0) res += ones[o] + ' و' + tens[t];
                        else res += tens[t];
                    }
                }
                return res;
            }

            const whole = Math.floor(numAmount);
            const piastres = Math.round((numAmount - whole) * 100);
            let parts = [];

            const millions = Math.floor(whole / 1000000);
            const thousands = Math.floor((whole % 1000000) / 1000);
            const rest = whole % 1000;

            if (millions > 0) {
                if (millions === 1) parts.push('مليون');
                else if (millions === 2) parts.push('مليونان');
                else if (millions >= 3 && millions <= 10) parts.push(convertGroup(millions) + ' ملايين');
                else parts.push(convertGroup(millions) + ' مليون');
            }

            if (thousands > 0) {
                if (thousands === 1) parts.push('ألف');
                else if (thousands === 2) parts.push('ألفان');
                else if (thousands >= 3 && thousands <= 10) parts.push(convertGroup(thousands) + ' آلاف');
                else parts.push(convertGroup(thousands) + ' ألف');
            }

            if (rest > 0) {
                parts.push(convertGroup(rest));
            }

            let result = 'فقط وقدره ' + (parts.join(' و') || 'صفر') + ' جنيهاً مصرياً';
            if (piastres > 0) {
                result += ' و' + convertGroup(piastres) + ' قرشاً';
            }
            result += ' لا غير.';
            return result;
        }

        /**
         * Global Application State
         */
        const AppState = {
            currentUser: null,
            supabaseClient: null,
            isCloud: false,
            categories: [],
            products: [],
            customers: [],
            suppliers: [],
            receipts: [],
            issues: [],
            invoices: [],
            adjustments: [],
            movements: [],
            settings: {},
