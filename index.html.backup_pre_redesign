                            (inv.status === 'draft' ? '<button class="btn btn-gold btn-sm" onclick="InvoicesModule.approveInvoice(\'' + inv.id + '\')" title="اعتماد وخصم المخزون"><i class="fa-solid fa-check-double"></i> اعتماد</button> ' : '') +
