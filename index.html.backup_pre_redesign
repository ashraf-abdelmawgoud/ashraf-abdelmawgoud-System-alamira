                    const diffText = diffNum > 0 ? ('+' + formatQty(diffNum)) : formatQty(diffNum);

                    return '<tr>' +
                        '<td><strong style="color: var(--navy-dark);">' + adj.adjustment_number + '</strong></td>' +
                        '<td>' + adj.adjustment_date + '</td>' +
                        '<td>' +
                            '<div>' + adj.reason + '</div>' +
                            (prod ? '<small style="color: var(--text-muted);">' + prod.sku + ' - ' + prod.name + ' (فارق: <strong>' + diffText + '</strong>)</small>' : '') +
                        '</td>' +
                        '<td><span class="badge badge-success"><i class="fa-solid fa-check"></i> معتمدة</span></td>' +
                        '<td>مستخدم مصرح به</td>' +
                        '<td style="text-align: center;"><span class="badge badge-gray">تم تحديث المخزون</span></td>' +
                    '</tr>';
                }).join('');
            },

            openModal() {
                const select = document.getElementById('adj-product');
                select.innerHTML = AppState.products.map(p => 
                    '<option value="' + p.id + '" data-stock="' + p.current_stock + '" data-allows-decimal="' + Boolean(p.allows_decimal_quantity) + '">' + p.sku + ' - ' + p.name + '</option>'
                ).join('');

                const nextNum = 'ADJ-' + new Date().toISOString().slice(0, 10).replace(/-/g, '') + '-' + String(AppState.adjustments.length + 1).padStart(3, '0');
                document.getElementById('adj-number').value = nextNum;
                document.getElementById('adj-date').value = new Date().toISOString().slice(0, 10);
                document.getElementById('adj-reason').value = '';

                this.handleProductSelect();
                document.getElementById('modal-adjustment').classList.add('active');
            },

            handleProductSelect() {
                const select = document.getElementById('adj-product');
                const selected = select.options[select.selectedIndex];
                const curStock = Number(selected ? selected.getAttribute('data-stock') : 0) || 0;
                const allowsDec = selected ? (selected.getAttribute('data-allows-decimal') === 'true') : false;

                const actualInput = document.getElementById('adj-actual-qty');
                if (actualInput) {
                    if (allowsDec) {
                        actualInput.step = "0.001";
                        actualInput.min = "0";
                    } else {
                        actualInput.step = "1";
                        actualInput.min = "0";
                    }
                }

                document.getElementById('adj-recorded-qty').value = formatQty(curStock);
                document.getElementById('adj-actual-qty').value = formatQty(curStock);
                this.calcDiff();
            },

            calcDiff() {
                const recorded = Number(document.getElementById('adj-recorded-qty').value) || 0;
                const actual = Number(document.getElementById('adj-actual-qty').value) || 0;
                const diff = Number((actual - recorded).toFixed(3));
                const diffEl = document.getElementById('adj-difference');
                diffEl.value = formatQty(diff);
                if (diff > 0) {
                    diffEl.style.color = 'var(--success)';
                } else if (diff < 0) {
                    diffEl.style.color = 'var(--danger)';
                } else {
                    diffEl.style.color = 'var(--navy-dark)';
                }
            },

            async handleSave(e) {
                e.preventDefault();
                if (!App.requireCloud()) return;

                const product_id = document.getElementById('adj-product').value;
                const recorded_quantity = Number(document.getElementById('adj-recorded-qty').value);
                const actual_quantity = Number(document.getElementById('adj-actual-qty').value);
                const difference = Number((actual_quantity - recorded_quantity).toFixed(3));
                const reason = document.getElementById('adj-reason').value.trim();
                const adjustment_number = document.getElementById('adj-number').value;
                const adjustment_date = document.getElementById('adj-date').value;

                if (isNaN(actual_quantity) || actual_quantity < 0) {
                    showToast('الكمية الفعلية لا يمكن أن تكون سالبة', 'error');
                    return;
                }

                const prod = AppState.products.find(p => p.id === product_id);
                if (prod && !prod.allows_decimal_quantity && (actual_quantity % 1 !== 0)) {
                    showToast('الصنف "' + prod.name + '" يباع بالعدد الصحيح فقط ولا يقبل كميات كسرية', 'warning');
                    document.getElementById('adj-actual-qty').focus();
                    return;
                }

                try {
                    const { data: adj, error: adjError } = await AppState.supabaseClient
                        .from('inventory_adjustments')
                        .insert([{
                            adjustment_number,
                            adjustment_date,
                            reason,
                            status: 'draft',
                            created_by: AppState.currentUser.id
                        }])
                        .select()
                        .single();

                    if (adjError) throw adjError;

                    const { error: itemError } = await AppState.supabaseClient
                        .from('inventory_adjustment_items')
                        .insert([{
                            adjustment_id: adj.id,
                            product_id,
                            recorded_quantity,
                            actual_quantity,
                            difference
                        }]);

                    if (itemError) throw itemError;

                    const { data, error: rpcError } = await AppState.supabaseClient
                        .rpc('approve_stock_adjustment', { p_adjustment_id: adj.id });

                    if (rpcError) throw rpcError;

                    App.closeModals();
                    showToast(data.message || 'تم اعتماد تسوية الجرد وتحديث رصيد المخزون', 'success');
                    await App.fetchCloudData();
                } catch (err) {
                    showToast('فشل اعتماد تسوية الجرد: ' + (err.message || err), 'error');
                }
            }
        };

