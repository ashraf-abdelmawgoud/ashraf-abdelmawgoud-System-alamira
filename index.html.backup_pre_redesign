        /**
         * Toast Notification Helper
         */
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'toast ' + type;
            const iconMap = {
                success: 'fa-circle-check',
                error: 'fa-circle-exclamation',
                warning: 'fa-triangle-exclamation',
                info: 'fa-circle-info'
            };
            toast.innerHTML = '<i class="fa-solid ' + (iconMap[type] || 'fa-info') + '"></i> <span>' + message + '</span>';
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(10px)';
                toast.style.transition = 'all 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 4500);
        }

        const DEFAULT_SUPABASE_URL = 'https://llmptlkvatndvrmnjiyj.supabase.co';
        const DEFAULT_SUPABASE_KEY = 'sb_publishable_7Bq-KxJj0xbpelQRabGsdg_q0EACC8W';
        const LEGACY_TYPO_SUPABASE_URL = 'https://llmptlkvatndvrmnijyj.supabase.co';

        /**
         * Main Application Controller & Cloud Bridge
         */
        const App = {
            async init() {
                this.updateDateDisplay();
                await this.checkSavedCloudConfig();
                await this.checkSession();
                this.checkBackupWarning();
            },

            updateDateDisplay() {
                const now = new Date();
                const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
                document.getElementById('current-arabic-date').innerText = now.toLocaleDateString('ar-EG', options);
            },

            async checkSavedCloudConfig() {
                let savedUrl = localStorage.getItem('alamira_supabase_url');
                // Auto-migrate legacy typo URL if present in user's browser localStorage without touching other settings
                if (savedUrl === LEGACY_TYPO_SUPABASE_URL || (savedUrl && savedUrl.includes('llmptlkvatndvrmnijyj'))) {
                    savedUrl = DEFAULT_SUPABASE_URL;
                    localStorage.setItem('alamira_supabase_url', DEFAULT_SUPABASE_URL);
                } else if (!savedUrl) {
                    savedUrl = DEFAULT_SUPABASE_URL;
                }

                const savedKey = localStorage.getItem('alamira_supabase_key') || DEFAULT_SUPABASE_KEY;
                const connPill = document.getElementById('connection-pill');
                const connText = document.getElementById('connection-status-text');
                const authMode = document.getElementById('auth-mode-indicator');
                const offlineBanner = document.getElementById('offline-warning-banner');

                if (savedUrl && savedKey && window.supabase) {
                    try {
                        AppState.supabaseClient = window.supabase.createClient(savedUrl, savedKey);
                        AppState.isCloud = true;
                        connPill.className = 'status-pill online';
                        connText.innerText = 'متصل بـ Supabase';
                        authMode.innerHTML = '<i class="fa-solid fa-cloud"></i> متصل بالسحابة (Al-Amira)';
                        if (offlineBanner) offlineBanner.style.display = 'none';
                        return true;
                    } catch (e) {
                        this.setDisconnectedState('خطأ في تهيئة عميل Supabase: ' + e.message);
                        return false;
                    }
                } else {
                    this.setDisconnectedState('لم يتم إدخال إعدادات الربط السحابي (URL و Publishable Key)');
                    return false;
                }
            },

            setDisconnectedState(reason) {
                AppState.isCloud = false;
                AppState.supabaseClient = null;
                const connPill = document.getElementById('connection-pill');
                const connText = document.getElementById('connection-status-text');
                const authMode = document.getElementById('auth-mode-indicator');
                const offlineBanner = document.getElementById('offline-warning-banner');

                connPill.className = 'status-pill danger';
                connText.innerText = 'غير متصل بالسحابة (انقر للربط)';
                authMode.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> غير متصل بالسحابة';
                if (offlineBanner) offlineBanner.style.display = 'flex';
            },

            requireCloud() {
                if (!AppState.isCloud || !AppState.supabaseClient) {
                    showToast('تعذر إتمام العملية: النظام يعمل في وضع الاتصال السحابي الحصري وغير متصل بـ Supabase. تم منع حفظ أو اعتماد أي معاملات محلياً لضمان سلامة المخزون.', 'error');
                    this.openConfigModal();
                    return false;
                }
                return true;
            },

            async checkSession() {
                if (!AppState.isCloud || !AppState.supabaseClient) {
                    document.getElementById('auth-screen').style.display = 'flex';
                    return;
                }

                try {
                    const { data: { session }, error } = await AppState.supabaseClient.auth.getSession();
                    if (session && session.user) {
                        // Fetch authorized user record from allowlist table
                        const { data: authUser, error: authErr } = await AppState.supabaseClient
                            .from('authorized_users')
                            .select('*')
                            .eq('user_id', session.user.id)
                            .single();

                        if (authErr || !authUser || !authUser.is_active) {
                            await AppState.supabaseClient.auth.signOut();
                            document.getElementById('auth-screen').style.display = 'flex';
                            return;
                        }

                        AppState.currentUser = {
                            id: session.user.id,
                            email: session.user.email,
                            role: 'authorized_user',
                            full_name: authUser.full_name || session.user.email
                        };

                        await this.onAuthenticated();
                    } else {
                        document.getElementById('auth-screen').style.display = 'flex';
                    }
                } catch (e) {
                    document.getElementById('auth-screen').style.display = 'flex';
                }
            },

            async handleLogin(e) {
                e.preventDefault();
                const email = document.getElementById('login-email').value.trim();
                const pwd = document.getElementById('login-password').value;

                if (!AppState.isCloud || !AppState.supabaseClient) {
                    showToast('تعذر تسجيل الدخول: التطبيق غير متصل بقاعدة بيانات Supabase. يرجى إدخال Project URL و Anon Public Key عبر زر إعدادات الربط السحابي بالأسفل.', 'error');
                    App.openConfigModal();
                    return;
                }

                const btnSubmit = document.getElementById('btn-login-submit');
                btnSubmit.disabled = true;
                btnSubmit.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> جاري التحقق من الخادم السحابي...';

                try {
                    // Direct authentication against Supabase Auth without any local bypass
                    const { data, error } = await AppState.supabaseClient.auth.signInWithPassword({
                        email,
                        password: pwd
                    });

                    if (error) {
                        throw error;
                    }

                    // Verify membership in server-controlled authorized_users allowlist
                    const { data: authUser, error: authError } = await AppState.supabaseClient
                        .from('authorized_users')
                        .select('*')
                        .eq('user_id', data.user.id)
                        .single();

                    if (authError || !authUser) {
                        await AppState.supabaseClient.auth.signOut();
                        throw new Error('تم التحقق من بيانات الدخول، ولكن هذا الحساب غير مدرج في قائمة المستخدمين المصرح لهم (authorized_users).');
                    }

                    if (!authUser.is_active) {
                        await AppState.supabaseClient.auth.signOut();
                        throw new Error('عفواً، تم تعطيل هذا الحساب.');
                    }

                    AppState.currentUser = {
                        id: data.user.id,
                        email: data.user.email,
                        role: 'authorized_user',
                        full_name: authUser.full_name || email
                    };

                    await this.onAuthenticated();
                } catch (err) {
                    let msg = err.message || 'بيانات الدخول غير صحيحة';
                    if (msg.includes('Invalid login credentials')) {
                        msg = 'بيانات تسجيل الدخول غير صحيحة. يرجى التأكد من البريد الإلكتروني وكلمة المرور المسجلة في Supabase Auth.';
                    } else if (msg.includes('Failed to fetch') || msg.includes('NetworkError') || msg.includes('ENOTFOUND')) {
                        msg = 'تعذر الاتصال بخادم Supabase (Failed to fetch). يرجى التأكد من اتصال الإنترنت وأن مشروع Supabase يعمل ونطاقه متاح.';
                    }
                    showToast(msg, 'error');
                } finally {
                    btnSubmit.disabled = false;
                    btnSubmit.innerHTML = '<i class="fa-solid fa-right-to-bracket"></i> تسجيل الدخول للنظام';
                }
            },

            async onAuthenticated() {
                document.getElementById('auth-screen').style.display = 'none';
                document.getElementById('sidebar-user-name').innerText = AppState.currentUser.full_name;
                document.getElementById('sidebar-user-role').innerText = 'مستخدم مصرح به (كامل الصلاحيات)';
                document.getElementById('sidebar-user-avatar').innerText = AppState.currentUser.full_name.charAt(0);

                // Two Equal Users model: both authorized users have access to all operations
                const adjBtn = document.getElementById('btn-new-adjustment');
                const restoreBtn = document.getElementById('btn-restore-backup');
                if (adjBtn) adjBtn.style.display = 'inline-flex';
                if (restoreBtn) restoreBtn.style.display = 'inline-flex';

                showToast('مرحباً بك، ' + AppState.currentUser.full_name, 'success');
                await this.fetchCloudData();
            },

            async fetchCloudData() {
                if (!AppState.isCloud || !AppState.supabaseClient) return;

                try {
                    const client = AppState.supabaseClient;

                    // Fetch all core datasets from Supabase
                    const [
                        { data: cats },
                        { data: prods },
                        { data: custs },
                        { data: sups },
                        { data: recs },
                        { data: iss },
                        { data: invs },
                        { data: adjs },
                        { data: movs },
                        { data: bk },
                        { data: setts }
                    ] = await Promise.all([
                        client.from('categories').select('*').order('name'),
                        client.from('products').select('*').order('created_at', { ascending: false }),
                        client.from('customers').select('*').order('name'),
                        client.from('suppliers').select('*').order('name'),
                        client.from('stock_receipts').select('*, items:stock_receipt_items(*)').order('created_at', { ascending: false }),
                        client.from('stock_issues').select('*, items:stock_issue_items(*)').order('created_at', { ascending: false }),
                        client.from('sales_invoices').select('*, items:sales_invoice_items(*)').order('created_at', { ascending: false }),
                        client.from('inventory_adjustments').select('*, items:inventory_adjustment_items(*)').order('created_at', { ascending: false }),
                        client.from('inventory_movements').select('*').order('created_at', { ascending: false }).limit(200),
                        client.from('backup_metadata').select('*').order('created_at', { ascending: false }).limit(1),
                        client.from('app_settings').select('*')
                    ]);

                    AppState.categories = cats || [];
                    AppState.products = prods || [];
                    AppState.customers = custs || [];
                    AppState.suppliers = sups || [];
                    AppState.receipts = recs || [];
                    AppState.issues = iss || [];
                    AppState.invoices = invs || [];
                    AppState.adjustments = adjs || [];
                    AppState.movements = movs || [];
                    if (bk && bk.length > 0) AppState.lastBackupTime = bk[0].created_at;
                    AppState.settings = {};
                    if (setts) {
                        setts.forEach(s => {
                            AppState.settings[s.key] = s.value;
                        });
                    }

                    this.renderAll();
                } catch (err) {
                    showToast('خطأ أثناء تحميل البيانات من Supabase: ' + (err.message || err), 'error');
                }
            },

            async logout() {
                if (AppState.supabaseClient) {
                    try { await AppState.supabaseClient.auth.signOut(); } catch(e) {}
                }
                AppState.currentUser = null;
                document.getElementById('auth-screen').style.display = 'flex';
                showToast('تم تسجيل الخروج بنجاح', 'info');
            },

            navigate(viewId) {
                document.querySelectorAll('.view-section').forEach(el => el.classList.remove('active'));
                document.querySelectorAll('.menu-item').forEach(el => el.classList.remove('active'));

                const target = document.getElementById(viewId);
                if (target) {
                    target.classList.add('active');
                }

                const menuItem = document.querySelector('.menu-item[data-view="' + viewId + '"]');
                if (menuItem) {
                    menuItem.classList.add('active');
                    const title = menuItem.querySelector('span').innerText;
                    document.getElementById('page-title').innerText = title;
                    const iconClass = menuItem.querySelector('i').className;
                    document.getElementById('page-icon').className = iconClass;
                }

                document.getElementById('sidebar').classList.remove('mobile-open');

                if (viewId === 'view-dashboard') DashboardModule.render();
                if (viewId === 'view-products') ProductsModule.renderTable();
                if (viewId === 'view-receipts') ReceiptsModule.renderTable();
                if (viewId === 'view-issues') IssuesModule.renderTable();
                if (viewId === 'view-invoices') InvoicesModule.renderTable();
                if (viewId === 'view-adjustments') AdjustmentsModule.renderTable();
                if (viewId === 'view-contacts') ContactsModule.renderTable();
                if (viewId === 'view-movements') MovementsModule.renderTable();
                if (viewId === 'view-reports') ReportsModule.runReport();
                if (viewId === 'view-backup') BackupRestoreModule.renderStatus();
            },

            toggleSidebar() {
                document.getElementById('sidebar').classList.toggle('mobile-open');
            },

            closeModals() {
                document.querySelectorAll('.modal-backdrop').forEach(m => m.classList.remove('active'));
            },

            openConfigModal() {
                let savedUrl = localStorage.getItem('alamira_supabase_url');
                if (savedUrl === LEGACY_TYPO_SUPABASE_URL || (savedUrl && savedUrl.includes('llmptlkvatndvrmnijyj'))) {
                    savedUrl = DEFAULT_SUPABASE_URL;
                    localStorage.setItem('alamira_supabase_url', DEFAULT_SUPABASE_URL);
                }
                document.getElementById('config-supabase-url').value = savedUrl || DEFAULT_SUPABASE_URL;
                document.getElementById('config-supabase-key').value = localStorage.getItem('alamira_supabase_key') || DEFAULT_SUPABASE_KEY;
                document.getElementById('modal-config').classList.add('active');
            },

            resetToDefaultConfig() {
                document.getElementById('config-supabase-url').value = DEFAULT_SUPABASE_URL;
                document.getElementById('config-supabase-key').value = DEFAULT_SUPABASE_KEY;
                localStorage.setItem('alamira_supabase_url', DEFAULT_SUPABASE_URL);
                localStorage.setItem('alamira_supabase_key', DEFAULT_SUPABASE_KEY);
                this.checkSavedCloudConfig();
                showToast('تمت استعادة إعدادات مشروع Supabase الافتراضية بنجاح', 'success');
            },

            async saveSupabaseConfig(e) {
                e.preventDefault();
                const url = document.getElementById('config-supabase-url').value.trim();
                const key = document.getElementById('config-supabase-key').value.trim();

                if (url && key) {
                    localStorage.setItem('alamira_supabase_url', url);
                    localStorage.setItem('alamira_supabase_key', key);
                    const connected = await this.checkSavedCloudConfig();
                    if (connected) {
                        showToast('تم حفظ الإعدادات وربط السحابة بنجاح', 'success');
                        this.closeModals();
                        if (AppState.currentUser) {
                            await this.fetchCloudData();
                        }
                    } else {
                        showToast('فشل التحقق من الرابط أو المفتاح. يرجى التأكد من صحة بيانات مشروع Supabase.', 'error');
                    }
                } else {
                    localStorage.removeItem('alamira_supabase_url');
                    localStorage.removeItem('alamira_supabase_key');
                    this.setDisconnectedState('تم مسح إعدادات الربط السحابي');
                    this.closeModals();
                    showToast('تم مسح إعدادات السحابة. لا يمكن إجراء معاملات في هذا الوضع.', 'warning');
                }
            },

            checkBackupWarning() {
                const last = AppState.lastBackupTime ? new Date(AppState.lastBackupTime) : null;
                const now = new Date();
                const alertEl = document.getElementById('topbar-backup-alert');
                if (!last || (now - last) > (24 * 60 * 60 * 1000)) {
                    alertEl.style.display = 'inline-flex';
                } else {
                    alertEl.style.display = 'none';
                }
            },

            renderAll() {
                DashboardModule.render();
                ProductsModule.renderTable();
                ReceiptsModule.renderTable();
                IssuesModule.renderTable();
                InvoicesModule.renderTable();
                AdjustmentsModule.renderTable();
                ContactsModule.renderTable();
                MovementsModule.renderTable();
                BackupRestoreModule.renderStatus();
                this.checkBackupWarning();
            },

            openAddProductModal() { ProductsModule.openModal(); },
            openNewReceiptModal() { ReceiptsModule.openModal(); },
            openNewIssueModal() { IssuesModule.openModal(); },
            openNewInvoiceModal() { InvoicesModule.openModal(); },
            openNewAdjustmentModal() { AdjustmentsModule.openModal(); }
        };

        /**
         * --------------------------------------------------------------------------
         * MODULE 1: DASHBOARD
         * --------------------------------------------------------------------------
         */
        const DashboardModule = {
            render() {
                const prods = AppState.products;
                const activeProds = prods.filter(p => p.is_active);
                const totalUnits = prods.reduce((sum, p) => sum + Number(p.current_stock || 0), 0);
                const estimatedVal = prods.reduce((sum, p) => sum + (Number(p.current_stock || 0) * Number(p.purchase_price || 0)), 0);
                const lowStockProds = prods.filter(p => Number(p.current_stock || 0) > 0 && Number(p.current_stock || 0) <= Number(p.min_stock_level || 5));
                const outOfStockProds = prods.filter(p => Number(p.current_stock || 0) <= 0);

                const approvedInvoices = AppState.invoices.filter(i => i.status === 'approved');
                const totalSales = approvedInvoices.reduce((sum, i) => sum + Number(i.final_total || 0), 0);

                const approvedReceipts = AppState.receipts.filter(r => r.status === 'approved');
                const totalPurchases = approvedReceipts.reduce((sum, r) => sum + Number(r.total_amount || 0), 0);

                const approvedIssues = AppState.issues.filter(i => i.status === 'approved');

                document.getElementById('kpi-active-products').innerText = activeProds.length;
                document.getElementById('kpi-total-units').innerText = totalUnits.toLocaleString('ar-EG');
                document.getElementById('kpi-inventory-value').innerText = round2(estimatedVal).toLocaleString('ar-EG') + ' ج.م';
                document.getElementById('kpi-low-stock').innerText = lowStockProds.length;
                document.getElementById('kpi-out-of-stock').innerText = outOfStockProds.length;
                document.getElementById('kpi-total-sales').innerText = round2(totalSales).toLocaleString('ar-EG') + ' ج.م';
                document.getElementById('kpi-total-purchases').innerText = round2(totalPurchases).toLocaleString('ar-EG') + ' ج.م';
                document.getElementById('kpi-count-invoices').innerText = approvedInvoices.length;
                document.getElementById('kpi-count-receipts').innerText = approvedReceipts.length;
                document.getElementById('kpi-count-issues').innerText = approvedIssues.length;

                document.getElementById('badge-products-count').innerText = prods.length;

                // Render Low Stock Widget Table
                const lowStockTable = document.getElementById('table-dashboard-low-stock');
                const critical = [...outOfStockProds, ...lowStockProds].slice(0, 5);
                if (critical.length === 0) {
                    lowStockTable.innerHTML = '<tr><td colspan="5" style="text-align:center; color: var(--text-muted); padding: 16px;">جميع مستويات المخزون آمنة وممتازة</td></tr>';
                } else {
                    lowStockTable.innerHTML = critical.map(p => {
                        const isZero = Number(p.current_stock) <= 0;
                        return '<tr>' +
                            '<td><strong>' + p.sku + '</strong></td>' +
                            '<td>' + p.name + '</td>' +
                            '<td><strong>' + p.current_stock + '</strong> ' + p.unit + '</td>' +
                            '<td>' + p.min_stock_level + ' ' + p.unit + '</td>' +
                            '<td><span class="badge ' + (isZero ? 'badge-danger' : 'badge-warning') + '">' + (isZero ? 'نفد تماماً' : 'منخفض') + '</span></td>' +
                        '</tr>';
                    }).join('');
                }

                // Render Recent Movements Widget Table
                const recentMovementsTable = document.getElementById('table-dashboard-recent-movements');
                const recent = [...AppState.movements].slice(0, 5);
                if (recent.length === 0) {
                    recentMovementsTable.innerHTML = '<tr><td colspan="5" style="text-align:center; color: var(--text-muted); padding: 16px;">لا توجد حركات مخزون مسجلة بعد</td></tr>';
                } else {
                    recentMovementsTable.innerHTML = recent.map(m => {
                        const prod = AppState.products.find(p => p.id === m.product_id) || { name: 'صنف' };
                        const typeMap = {
                            receipt: '<span class="badge badge-success">إضافة وارد (+)</span>',
                            sale: '<span class="badge badge-info">بيع صادر (-)</span>',
                            issue: '<span class="badge badge-warning">صرف صادر (-)</span>',
                            adjustment: '<span class="badge badge-gray">تسوية جردية</span>',
                            reversal: '<span class="badge badge-danger">إلغاء وإرجاع</span>'
                        };
                        const qtyText = m.quantity_in > 0 ? ('+' + m.quantity_in) : ('-' + m.quantity_out);
                        return '<tr>' +
                            '<td>' + (typeMap[m.movement_type] || m.movement_type) + '</td>' +
                            '<td><strong>' + m.source_doc_number + '</strong></td>' +
                            '<td>' + prod.name + '</td>' +
                            '<td><strong>' + qtyText + '</strong></td>' +
                            '<td>' + m.stock_balance_after + '</td>' +
                        '</tr>';
                    }).join('');
                }
            }
        };

        /**
         * --------------------------------------------------------------------------
         * MODULE 2: PRODUCTS
         * --------------------------------------------------------------------------
         */
        const ProductsModule = {
            renderTable() {
                const tbody = document.getElementById('products-table-body');
                const search = (document.getElementById('product-search')?.value || '').toLowerCase().trim();
                const catFilter = document.getElementById('product-filter-category')?.value || '';
                const stockFilter = document.getElementById('product-filter-stock')?.value || '';

                const catSelect = document.getElementById('product-filter-category');
                if (catSelect && catSelect.children.length <= 1) {
                    AppState.categories.forEach(c => {
                        catSelect.innerHTML += '<option value="' + c.id + '">' + c.name + '</option>';
                    });
                }

                let list = AppState.products.filter(p => {
                    const matchSearch = p.name.toLowerCase().includes(search) || p.sku.toLowerCase().includes(search);
                    const matchCat = !catFilter || p.category_id === catFilter;
                    let matchStock = true;
                    const stock = Number(p.current_stock || 0);
                    const min = Number(p.min_stock_level || 5);
                    if (stockFilter === 'low') matchStock = stock > 0 && stock <= min;
                    if (stockFilter === 'out') matchStock = stock <= 0;
                    if (stockFilter === 'available') matchStock = stock > min;
                    return matchSearch && matchCat && matchStock;
                });

                if (list.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="10" style="text-align:center; padding: 24px; color: var(--text-muted);">لا توجد أصناف مطابقة لمعايير البحث</td></tr>';
                    return;
                }

                tbody.innerHTML = list.map(p => {
                    const cat = AppState.categories.find(c => c.id === p.category_id);
                    const stock = Number(p.current_stock || 0);
                    const min = Number(p.min_stock_level || 5);
                    let badge = '<span class="badge badge-success">متوفر</span>';
                    if (stock <= 0) badge = '<span class="badge badge-danger">نفد من المخزن</span>';
                    else if (stock <= min) badge = '<span class="badge badge-warning">رصيد حرج</span>';

                    return '<tr>' +
                        '<td><strong style="color: var(--navy-dark);">' + p.sku + '</strong></td>' +
                        '<td><strong style="font-size: 14px;">' + p.name + '</strong></td>' +
                        '<td>' + (cat ? cat.name : '--') + '</td>' +
                        '<td><span class="badge badge-gray">' + p.unit + (p.allows_decimal_quantity ? ' <small style="color: #0284c7; font-weight: 700;">(كسور)</small>' : '') + '</span></td>' +
                        '<td>' + round2(p.purchase_price) + ' ج.م</td>' +
                        '<td><strong style="color: var(--navy-dark);">' + round2(p.selling_price) + ' ج.م</strong></td>' +
                        '<td><strong style="font-size: 15px;">' + formatQty(stock) + '</strong> ' + p.unit + '</td>' +
                        '<td>' + formatQty(min) + '</td>' +
                        '<td>' + badge + '</td>' +
                        '<td style="text-align: center; white-space: nowrap;">' +
                            '<button class="btn btn-outline btn-sm" onclick="ProductsModule.openModal(\'' + p.id + '\')" title="تعديل بيانات الصنف"><i class="fa-solid fa-pen-to-square"></i></button> ' +
                            '<button class="btn btn-outline btn-sm" onclick="ProductsModule.viewHistory(\'' + p.id + '\')" title="سجل حركات الصنف"><i class="fa-solid fa-clock-rotate-left"></i></button>' +
                        '</td>' +
                    '</tr>';
                }).join('');
            },

            onUnitChange(unit) {
                const checkbox = document.getElementById('prod-form-allows-decimal');
                if (!checkbox) return;
                if (['متر', 'كجم', 'لتر', 'طن'].includes(unit)) {
                    checkbox.checked = true;
                } else if (['قطعة', 'علبة', 'كرتونة', 'طقم', 'رزمة'].includes(unit)) {
                    checkbox.checked = false;
                }
            },

            openModal(productId = null) {
                const catSelect = document.getElementById('prod-form-category');
                catSelect.innerHTML = '<option value="">-- بدون تصنيف --</option>' + 
                    AppState.categories.map(c => '<option value="' + c.id + '">' + c.name + '</option>').join('');

                if (productId) {
                    const p = AppState.products.find(item => item.id === productId);
                    if (!p) return;
                    document.getElementById('modal-product-title').innerHTML = '<i class="fa-solid fa-pen-to-square" style="color: var(--gold-primary);"></i> تعديل بيانات الصنف';
                    document.getElementById('prod-form-id').value = p.id;
                    document.getElementById('prod-form-sku').value = p.sku;
                    document.getElementById('prod-form-sku').readOnly = true;
                    document.getElementById('prod-form-name').value = p.name;
                    document.getElementById('prod-form-category').value = p.category_id || '';
                    document.getElementById('prod-form-unit').value = p.unit || 'قطعة';
                    document.getElementById('prod-form-allows-decimal').checked = Boolean(p.allows_decimal_quantity);
                    document.getElementById('prod-form-purchase-price').value = p.purchase_price != null ? p.purchase_price : '';
                    document.getElementById('prod-form-selling-price').value = p.selling_price != null ? p.selling_price : '';
                    document.getElementById('prod-form-min-stock').value = p.min_stock_level != null ? formatQty(p.min_stock_level) : '5';
                    document.getElementById('prod-form-desc').value = p.description || '';
                } else {
                    document.getElementById('modal-product-title').innerHTML = '<i class="fa-solid fa-box-open" style="color: var(--gold-primary);"></i> إضافة صنف جديد';
                    document.getElementById('prod-form-id').value = '';
                    document.getElementById('prod-form-sku').value = '';
                    document.getElementById('prod-form-sku').readOnly = false;
                    document.getElementById('prod-form-name').value = '';
                    document.getElementById('prod-form-category').value = '';
                    document.getElementById('prod-form-unit').value = 'قطعة';
                    document.getElementById('prod-form-allows-decimal').checked = false;
                    document.getElementById('prod-form-purchase-price').value = '';
                    document.getElementById('prod-form-selling-price').value = '';
                    document.getElementById('prod-form-min-stock').value = '5';
                    document.getElementById('prod-form-desc').value = '';
                }

                document.getElementById('modal-product').classList.add('active');
                setTimeout(() => {
                    const skuInput = document.getElementById('prod-form-sku');
                    if (skuInput && !skuInput.readOnly) skuInput.focus();
                }, 100);
            },

            async saveProduct(e) {
                e.preventDefault();
                if (!App.requireCloud()) return;

                const id = document.getElementById('prod-form-id').value;
                const sku = document.getElementById('prod-form-sku').value.trim().toUpperCase();
                const name = document.getElementById('prod-form-name').value.trim();
                const category_id = document.getElementById('prod-form-category').value || null;
                const unit = document.getElementById('prod-form-unit').value || 'قطعة';
                const allows_decimal_quantity = document.getElementById('prod-form-allows-decimal').checked;
                const purchasePriceInput = document.getElementById('prod-form-purchase-price').value;
                const sellingPriceInput = document.getElementById('prod-form-selling-price').value;
                const minStockInput = document.getElementById('prod-form-min-stock').value;
                const description = document.getElementById('prod-form-desc').value.trim();

                // 1. Required fields validation
                if (!sku) {
                    showToast('يرجى إدخال كود الصنف (SKU) المطلوب', 'warning');
                    document.getElementById('prod-form-sku').focus();
                    return;
                }
                if (!name) {
                    showToast('يرجى إدخال اسم المنتج أو الصنف', 'warning');
                    document.getElementById('prod-form-name').focus();
                    return;
                }

                // 2. Numeric validation
                const purchase_price = purchasePriceInput !== '' ? round2(Number(purchasePriceInput)) : 0.00;
                const selling_price = sellingPriceInput !== '' ? round2(Number(sellingPriceInput)) : 0.00;
                const min_stock_level = minStockInput !== '' ? Number(minStockInput) : 5;

                if (isNaN(purchase_price) || purchase_price < 0) {
                    showToast('سعر الشراء الافتراضي يجب أن يكون صفراً أو رقماً موجباً', 'warning');
                    return;
                }
                if (isNaN(selling_price) || selling_price < 0) {
                    showToast('سعر البيع الافتراضي يجب أن يكون صفراً أو رقماً موجباً', 'warning');
                    return;
                }
                if (isNaN(min_stock_level) || min_stock_level < 0) {
                    showToast('الحد الأدنى للرصيد يجب أن يكون صفراً أو رقماً موجباً', 'warning');
                    return;
                }
                if (!allows_decimal_quantity && (min_stock_level % 1 !== 0)) {
                    showToast('الحد الأدنى للرصيد يجب أن يكون عدداً صحيحاً طالما أن الصنف لا يقبل كسوراً عشرية', 'warning');
                    document.getElementById('prod-form-min-stock').focus();
                    return;
                }

                // 3. Client-side duplicate SKU check
                const duplicate = AppState.products.find(p => p.sku.toUpperCase() === sku && p.id !== id);
                if (duplicate) {
                    showToast('كود الصنف (' + sku + ') مستخدم بالفعل للصنف "' + duplicate.name + '". يرجى استخدام كود فريد.', 'error');
                    document.getElementById('prod-form-sku').focus();
                    return;
                }

                const btnSubmit = document.getElementById('btn-save-product');
                const origHtml = btnSubmit ? btnSubmit.innerHTML : 'حفظ الصنف';
                if (btnSubmit) {
                    btnSubmit.disabled = true;
                    btnSubmit.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> جاري حفظ الصنف في قاعدة البيانات...';
                }

                try {
                    const updatePayload = {
                        name,
                        category_id,
                        unit,
                        allows_decimal_quantity,
                        purchase_price,
                        selling_price,
                        min_stock_level,
                        description,
                        updated_at: new Date().toISOString()
                    };

                    const insertPayload = {
                        sku,
                        name,
                        category_id,
                        unit,
                        allows_decimal_quantity,
                        purchase_price,
                        selling_price,
                        min_stock_level,
                        current_stock: 0.00,
                        description,
                        is_active: true
                    };

                    if (id) {
                        let { error } = await AppState.supabaseClient
                            .from('products')
                            .update(updatePayload)
                            .eq('id', id);

                        if (error && error.message && error.message.includes('allows_decimal_quantity')) {
                            delete updatePayload.allows_decimal_quantity;
                            const retry = await AppState.supabaseClient.from('products').update(updatePayload).eq('id', id);
                            error = retry.error;
                            if (!error) {
                                showToast('تنبيه: تم حفظ الصنف لكن يرجى تنفيذ ملف الهجرة migration_decimal_quantities.sql في Supabase لتفعيل دعم الكسور في قاعدة البيانات.', 'warning');
                            }
                        }

                        if (error) throw error;
                        showToast('تم تحديث بيانات الصنف (' + sku + ') بنجاح في قاعدة البيانات', 'success');
                    } else {
                        let { error } = await AppState.supabaseClient
                            .from('products')
                            .insert([insertPayload]);

                        if (error && error.message && error.message.includes('allows_decimal_quantity')) {
                            delete insertPayload.allows_decimal_quantity;
                            const retry = await AppState.supabaseClient.from('products').insert([insertPayload]);
                            error = retry.error;
                            if (!error) {
                                showToast('تنبيه: تم حفظ الصنف الجديد لكن يرجى تنفيذ ملف الهجرة migration_decimal_quantities.sql في Supabase لتفعيل دعم الكسور في قاعدة البيانات.', 'warning');
                            }
                        }

                        if (error) {
                            if (error.code === '23505') {
                                throw new Error('كود الصنف (' + sku + ') مسجل مسبقاً في قاعدة البيانات. يرجى إدخال كود غير مكرر.');
                            }
                            throw error;
                        }
                        showToast('تمت إضافة الصنف الجديد (' + sku + ' - ' + name + ') بنجاح برصيد أولي 0.00', 'success');
                    }

                    App.closeModals();
                    await App.fetchCloudData();
                } catch (err) {
                    showToast('فشل حفظ الصنف: ' + (err.message || err), 'error');
                } finally {
                    if (btnSubmit) {
                        btnSubmit.disabled = false;
                        btnSubmit.innerHTML = origHtml;
                    }
                }
