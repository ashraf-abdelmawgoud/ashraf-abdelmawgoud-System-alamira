    <!-- ========================================================================
         3. MAIN CONTENT WRAPPER
         ======================================================================== -->
    <div class="main-wrapper">
        <!-- Top Navigation Bar -->
        <header class="topbar">
            <div class="topbar-left">
                <button class="mobile-toggle" onclick="App.toggleSidebar()">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div class="page-header-title">
                    <i id="page-icon" class="fa-solid fa-chart-pie" style="color: var(--gold-primary);"></i>
                    <span id="page-title">لوحة التحكم والإحصائيات</span>
                </div>
            </div>

            <div class="topbar-right">
                <!-- Topbar Quick Actions -->
                <div class="topbar-quick-btns" style="display: flex; align-items: center; gap: 8px;">
                    <button class="btn btn-gold btn-sm" onclick="App.openNewInvoiceModal()" title="تحرير فاتورة مبيعات جديدة">
                        <i class="fa-solid fa-plus"></i> فاتورة مبيعات
                    </button>
                    <button class="btn btn-outline btn-sm" onclick="App.openAddProductModal()" title="إضافة صنف جديد">
                        <i class="fa-solid fa-plus"></i> صنف جديد
                    </button>
                    <button class="btn btn-outline btn-sm" onclick="App.openNewReceiptModal()" title="إذن استلام بضاعة للمخزن">
                        <i class="fa-solid fa-dolly"></i> إذن إضافة
                    </button>
                </div>

                <!-- Backup freshness alert badge -->
                <div id="topbar-backup-alert" class="status-pill warning" style="display: none; cursor: pointer;" onclick="App.navigate('view-backup')">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span>تنبيه: مضى أكثر من 24 ساعة على آخر نسخة احتياطية</span>
                </div>

                <!-- Backend Connection Pill -->
                <div id="connection-pill" class="status-pill online" onclick="App.openConfigModal()" style="cursor: pointer;" title="انقر لتعديل إعدادات الربط">
                    <i class="fa-solid fa-cloud"></i>
                    <span id="connection-status-text">متصل بالسحابة</span>
                </div>

                <!-- Date display -->
                <div style="font-size: 12px; font-weight: 700; color: var(--navy-dark); display: flex; align-items: center; gap: 6px;">
                    <i class="fa-regular fa-calendar-days" style="color: var(--gold-primary);"></i>
                    <span id="current-arabic-date">--</span>
                </div>

                <!-- Quick Settings Button -->
                <button class="topbar-btn" onclick="App.openConfigModal()" title="إعدادات النظام والربط السحابي">
                    <i class="fa-solid fa-sliders"></i>
                </button>
            </div>
        </header>

        <!-- Main Body Container -->
        <main class="content-body">

            <!-- Offline / Connection Warning Banner -->
            <div id="offline-warning-banner" style="display: none; background-color: var(--danger-light); border: 1px solid var(--danger); border-radius: var(--radius-sm); padding: 12px 16px; margin-bottom: 20px; color: var(--danger); font-weight: 700; align-items: center; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <i class="fa-solid fa-triangle-exclamation" style="font-size: 18px;"></i>
                    <span>تنبيه أمان: النظام في وضع الاتصال السحابي الحصري وغير متصل بـ Supabase. تم إيقاف واعتماد أي معاملات تجارية أو فواتير محلياً لحماية المخزون من التضارب.</span>
                </div>
                <button class="btn btn-danger btn-sm" onclick="App.openConfigModal()">
                    <i class="fa-solid fa-gear"></i> ضبط إعدادات السحابة
                </button>
            </div>


            <!-- ----------------------------------------------------------------
                 VIEW 1: DASHBOARD
                 ---------------------------------------------------------------- -->
            <section id="view-dashboard" class="view-section active">
                <!-- 10 KPI Cards -->
                <div class="grid-kpi">
                    <!-- 1. Active Products -->
                    <div class="kpi-card gold">
                        <div class="kpi-info">
                            <h4>المنتجات النشطة</h4>
                            <div class="kpi-value" id="kpi-active-products">0</div>
                            <div class="kpi-sub">صنف مسجل بالنظام</div>
                        </div>
                        <div class="kpi-icon"><i class="fa-solid fa-box-open"></i></div>
                    </div>

                    <!-- 2. Total Inventory Units -->
                    <div class="kpi-card info">
                        <div class="kpi-info">
                            <h4>إجمالي وحدات المخزون</h4>
                            <div class="kpi-value" id="kpi-total-units">0</div>
                            <div class="kpi-sub">قطعة / وحدة فعلية</div>
                        </div>
                        <div class="kpi-icon"><i class="fa-solid fa-cubes"></i></div>
                    </div>

                    <!-- 3. Estimated Inventory Valuation -->
                    <div class="kpi-card success">
                        <div class="kpi-info">
                            <h4>قيمة المخزون بسعر الشراء</h4>
                            <div class="kpi-value" id="kpi-inventory-value">0 ج.م</div>
                            <div class="kpi-sub">تقييم تقديري للتكلفة</div>
                        </div>
                        <div class="kpi-icon"><i class="fa-solid fa-sack-dollar"></i></div>
                    </div>

                    <!-- 4. Low Stock Count -->
                    <div class="kpi-card warning">
                        <div class="kpi-info">
                            <h4>أوشك على النفاد (حد أدنى)</h4>
                            <div class="kpi-value" id="kpi-low-stock">0</div>
                            <div class="kpi-sub">بحاجة لإعادة الطلب</div>
                        </div>
                        <div class="kpi-icon"><i class="fa-solid fa-bell"></i></div>
                    </div>

                    <!-- 5. Out of Stock -->
                    <div class="kpi-card danger">
                        <div class="kpi-info">
                            <h4>منتجات نفدت تماماً</h4>
                            <div class="kpi-value" id="kpi-out-of-stock">0</div>
                            <div class="kpi-sub">رصيد المخزن = صفر</div>
                        </div>
                        <div class="kpi-icon"><i class="fa-solid fa-circle-exclamation"></i></div>
                    </div>

                    <!-- 6. Total Sales -->
                    <div class="kpi-card success">
                        <div class="kpi-info">
                            <h4>إجمالي المبيعات (صافي)</h4>
                            <div class="kpi-value" id="kpi-total-sales">0 ج.م</div>
                            <div class="kpi-sub">فواتير مبيعات معتمدة</div>
                        </div>
                        <div class="kpi-icon"><i class="fa-solid fa-receipt"></i></div>
                    </div>

                    <!-- 7. Total Purchases -->
                    <div class="kpi-card gold">
                        <div class="kpi-info">
                            <h4>إجمالي قيمة المشتريات</h4>
                            <div class="kpi-value" id="kpi-total-purchases">0 ج.م</div>
                            <div class="kpi-sub">أذون إضافة معتمدة</div>
                        </div>
                        <div class="kpi-icon"><i class="fa-solid fa-cart-flatbed"></i></div>
                    </div>

                    <!-- 8. Approved Invoices Count -->
                    <div class="kpi-card info">
                        <div class="kpi-info">
                            <h4>عدد فواتير المبيعات</h4>
                            <div class="kpi-value" id="kpi-count-invoices">0</div>
                            <div class="kpi-sub">فاتورة معتمدة صادرة</div>
                        </div>
                        <div class="kpi-icon"><i class="fa-solid fa-file-invoice"></i></div>
                    </div>

                    <!-- 9. Approved Receipts Count -->
                    <div class="kpi-card gold">
                        <div class="kpi-info">
                            <h4>أذون الإضافة المعتمدة</h4>
                            <div class="kpi-value" id="kpi-count-receipts">0</div>
                            <div class="kpi-sub">إذن توريد للمخزن</div>
                        </div>
                        <div class="kpi-icon"><i class="fa-solid fa-dolly"></i></div>
                    </div>

                    <!-- 10. Approved Issues Count -->
                    <div class="kpi-card warning">
                        <div class="kpi-info">
                            <h4>أذون الصرف المعتمدة</h4>
