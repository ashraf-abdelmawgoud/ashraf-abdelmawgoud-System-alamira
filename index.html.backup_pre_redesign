                            <i class="fa-solid fa-truck-ramp-box"></i> إذن صرف بضاعة من المخزن
                        </button>
                        <button class="btn btn-outline" onclick="App.openAddProductModal()">
                            <i class="fa-solid fa-box"></i> إضافة صنف جديد
                        </button>
                    </div>
                </div>

                <!-- Dashboard 2-Column Section -->
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 20px;">
                    <!-- Low Stock Alerts Widget -->
                    <div class="card">
                        <div class="card-header">
                            <span class="card-title"><i class="fa-solid fa-triangle-exclamation" style="color: var(--danger);"></i> تنبيهات النواقص والحد الأدنى للمخزون</span>
                            <button class="btn btn-outline btn-sm" onclick="App.navigate('view-products')">عرض الكل</button>
                        </div>
                        <div class="card-body" style="padding: 0;">
                            <div class="table-responsive">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>كود SKU</th>
                                            <th>اسم الصنف</th>
                                            <th>الرصيد الحالي</th>
                                            <th>الحد الأدنى</th>
                                            <th>الحالة</th>
                                        </tr>
                                    </thead>
                                    <tbody id="table-dashboard-low-stock">
                                        <!-- Loaded dynamically -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Stock Movements Widget -->
                    <div class="card">
                        <div class="card-header">
                            <span class="card-title"><i class="fa-solid fa-clock-rotate-left" style="color: var(--navy-light);"></i> آخر حركات المخزون المسجلة</span>
                            <button class="btn btn-outline btn-sm" onclick="App.navigate('view-movements')">سجل الحركات</button>
