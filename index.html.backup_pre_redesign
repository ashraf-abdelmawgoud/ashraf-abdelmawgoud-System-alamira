            onProductChange(rowId) {
                const tr = document.getElementById(rowId);
                if (!tr) return;
                const select = tr.querySelector('.item-product');
                const selectedOpt = select ? select.options[select.selectedIndex] : null;
                const qtyInput = tr.querySelector('.item-qty');
                if (!selectedOpt || !selectedOpt.value) {
                    tr.querySelector('.item-unit').innerText = '--';
                    tr.querySelector('.item-price').value = '0.00';
                    this.recalculate();
                    return;
                }
                const unit = selectedOpt.getAttribute('data-unit') || '--';
                const price = selectedOpt.getAttribute('data-price') || '0.00';
                const allowsDec = selectedOpt.getAttribute('data-allows-decimal') === 'true';

                tr.querySelector('.item-unit').innerText = unit;
                tr.querySelector('.item-price').value = round2(Number(price)).toFixed(2);

                if (qtyInput) {
                    if (allowsDec) {
                        qtyInput.step = "0.001";
                        qtyInput.min = "0.001";
                        qtyInput.placeholder = "مثال: 1.5";
                    } else {
                        qtyInput.step = "1";
                        qtyInput.min = "1";
                        qtyInput.placeholder = "1";
                        if (qtyInput.value && Number(qtyInput.value) % 1 !== 0) {
                            qtyInput.value = Math.max(1, Math.round(Number(qtyInput.value)));
                        }
                    }
                }

                this.recalculate();
            },

            recalculate() {
                let grandTotal = 0;
                document.querySelectorAll('#receipt-items-tbody tr').forEach(tr => {
                    const qty = Number(tr.querySelector('.item-qty').value) || 0;
                    const price = Number(tr.querySelector('.item-price').value) || 0;
                    const total = round2(qty * price);
                    tr.querySelector('.item-total').innerText = total.toFixed(2) + ' ج.م';
                    grandTotal = round2(grandTotal + total);
                });
                document.getElementById('receipt-total-display').innerText = grandTotal.toFixed(2) + ' ج.م';
                return grandTotal;
            },

            async handleSave(e) {
                e.preventDefault();
                if (!App.requireCloud()) return;

                const action = e.submitter ? e.submitter.value : 'draft';
                const receipt_number = document.getElementById('receipt-number').value;
                const receipt_date = document.getElementById('receipt-date').value;
                const supplier_id = document.getElementById('receipt-supplier').value || null;
                const supplier_invoice_number = document.getElementById('receipt-sup-inv').value.trim();
                const notes = document.getElementById('receipt-notes').value.trim();

                const rows = document.querySelectorAll('#receipt-items-tbody tr');
                if (rows.length === 0) {
                    showToast('يجب إضافة صنف واحد على الأقل في الإذن', 'error');
                    return;
                }

                const items = [];
                for (let i = 0; i < rows.length; i++) {
                    const tr = rows[i];
                    const product_id = tr.querySelector('.item-product').value;
                    const quantity = Number(tr.querySelector('.item-qty').value);
                    const unit_price = Number(tr.querySelector('.item-price').value);

                    if (!product_id) {
                        showToast('يرجى اختيار صنف محدد في البند رقم (' + (i + 1) + ')', 'warning');
                        tr.querySelector('.item-product').focus();
                        return;
                    }
                    if (isNaN(quantity) || quantity <= 0) {
                        showToast('الكمية يجب أن تكون أكبر من الصفر في البند رقم (' + (i + 1) + ')', 'warning');
                        tr.querySelector('.item-qty').focus();
                        return;
                    }
                    const prod = AppState.products.find(p => p.id === product_id);
                    if (prod && !prod.allows_decimal_quantity && (quantity % 1 !== 0)) {
                        showToast('الصنف "' + prod.name + '" يباع بالعدد الصحيح فقط ولا يقبل كميات كسرية (الكمية المدخلة: ' + quantity + ')', 'warning');
                        tr.querySelector('.item-qty').focus();
                        return;
                    }

                    items.push({
                        product_id,
                        quantity,
                        unit_price,
                        line_total: round2(quantity * unit_price)
                    });
                }

                const total_amount = this.recalculate();

                try {
                    // 1. Insert header in Supabase
                    const { data: rec, error: recError } = await AppState.supabaseClient
                        .from('stock_receipts')
                        .insert([{
                            receipt_number,
                            receipt_date,
                            supplier_id,
                            supplier_invoice_number,
                            notes,
                            total_amount,
                            status: 'draft',
                            created_by: AppState.currentUser.id
                        }])
                        .select()
                        .single();

                    if (recError) throw recError;

                    // 2. Insert items in Supabase
                    const itemRows = items.map(it => ({
                        receipt_id: rec.id,
                        product_id: it.product_id,
                        quantity: it.quantity,
                        unit_price: it.unit_price,
                        line_total: it.line_total
                    }));

                    const { error: itemsError } = await AppState.supabaseClient
                        .from('stock_receipt_items')
                        .insert(itemRows);

                    if (itemsError) throw itemsError;

                    App.closeModals();

                    if (action === 'approve') {
                        await this.approveReceipt(rec.id);
                    } else {
                        showToast('تم حفظ مسودة إذن الإضافة رقم ' + receipt_number + ' سحابياً', 'success');
                        await App.fetchCloudData();
                    }
                } catch (err) {
                    showToast('فشل حفظ إذن الإضافة: ' + (err.message || err), 'error');
                }
            },

            async approveReceipt(receiptId) {
                if (!App.requireCloud()) return;
                try {
                    const { data, error } = await AppState.supabaseClient
                        .rpc('approve_stock_receipt', { p_receipt_id: receiptId });

                    if (error) throw error;
                    showToast(data.message || 'تم اعتماد إذن الإضافة وتحديث رصيد المخزون سحابياً', 'success');
