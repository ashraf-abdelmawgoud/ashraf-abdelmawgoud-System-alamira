            .print-card-box {
                border: 1px solid #cbd5e1;
                border-radius: 4px;
                padding: 6px 10px;
                background-color: #f8fafc !important;
            }
            .print-card-box .box-title {
                font-size: 8.5pt;
                font-weight: 800;
                color: #0a192f;
                border-bottom: 1px dashed #cbd5e1;
                padding-bottom: 3px;
                margin-bottom: 4px;
            }
            .print-table {
                width: 100%;
                border-collapse: collapse;
                margin: 8px 0;
                font-size: 8.5pt;
            }
            .print-table thead {
                display: table-header-group;
            }
            .print-table th {
                background-color: #0a192f !important;
                color: #ffffff !important;
                border: 1px solid #0a192f;
                padding: 5px 6px;
                font-weight: 800;
                text-align: center;
                font-size: 8.5pt;
                white-space: nowrap;
            }
            .print-table td {
                border: 1px solid #94a3b8;
                padding: 5px 6px;
                text-align: right;
                vertical-align: middle;
            }
            .print-table tr {
                page-break-inside: avoid;
            }
            .print-table tr:nth-child(even) td {
                background-color: #f8fafc !important;
            }
            .print-table .text-center {
                text-align: center;
            }
            .print-table .text-left {
                text-align: left;
            }
            .print-bottom-container {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                gap: 12px;
                margin-top: 8px;
                page-break-inside: avoid;
            }
            .print-notes-column {
                flex: 1;
            }
            .print-totals-column {
                width: 320px;
            }
            .print-totals-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 8.5pt;
                border: 1.5px solid #0a192f;
            }
            .print-totals-table td {
                padding: 4px 6px;
                border: 1px solid #cbd5e1;
            }
            .print-totals-table tr.final-total-row td {
                background-color: #0a192f !important;
                color: #ffffff !important;
                font-size: 10.5pt;
                font-weight: 900;
                border: 1.5px solid #0a192f;
            }
            .print-tafqeet-box {
                margin-top: 4px;
                background-color: #f1f5f9 !important;
                border: 1px dashed #64748b;
                border-radius: 4px;
                padding: 6px 8px;
                font-size: 8.5pt;
                font-weight: 700;
                color: #0f172a;
            }
            .print-signatures-section {
                margin-top: 20px;
                display: flex;
                justify-content: space-between;
                text-align: center;
                page-break-inside: avoid;
            }
            .print-sign-box {
                width: 30%;
                border-top: 1px dashed #475569;
                padding-top: 6px;
                font-size: 8.5pt;
                font-weight: 700;
                color: #1e293b;
            }
            .print-sign-box .sign-placeholder {
                height: 32px;
            }
        }

        /* Responsive */
        @media (max-width: 992px) {
            .sidebar {
                transform: translateX(100%);
            }
            .sidebar.mobile-open {
                transform: translateX(0);
            }
            .main-wrapper {
                margin-right: 0;
                width: 100%;
            }
            .mobile-toggle {
                display: block;
            }
        }
    </style>
</head>
<body>

    <!-- ========================================================================
         1. AUTHENTICATION OVERLAY SCREEN
         ======================================================================== -->
    <div id="auth-screen" class="auth-screen">
        <div class="auth-card">
            <div class="auth-logo">
                <i class="fa-solid fa-crown"></i>
            </div>
