                    <div class="card-header">
                        <span class="card-title"><i class="fa-solid fa-bolt" style="color: var(--gold-primary);"></i> الإجراءات السريعة</span>
                    </div>
                    <div class="card-body" style="display: flex; gap: 12px; flex-wrap: wrap;">
                        <button class="btn btn-gold" onclick="App.openNewInvoiceModal()">
                            <i class="fa-solid fa-plus-circle"></i> إنشاء فاتورة مبيعات جديدة
                        </button>
                        <button class="btn btn-primary" onclick="App.openNewReceiptModal()">
                            <i class="fa-solid fa-dolly"></i> إذن إضافة بضاعة (توريد)
                        </button>
