        /**
         * --------------------------------------------------------------------------
         * MODULE 11: FULL DATA BACKUP & RESTORE (SECURED VIA SERVER-SIDE RPC)
         * --------------------------------------------------------------------------
         */
        const BackupRestoreModule = {
            cachedRestoreData: null,

            renderStatus() {
                const tsEl = document.getElementById('last-backup-timestamp-text');
                if (AppState.lastBackupTime) {
                    const d = new Date(AppState.lastBackupTime);
                    tsEl.innerText = d.toLocaleString('ar-EG');
                } else {
                    tsEl.innerText = 'لم يتم إنشاء نسخة بعد';
                }
            },

            async createFullBackup() {
                if (!App.requireCloud()) return;

                showToast('جاري استخراج النسخة الاحتياطية من خادم قاعدة البيانات...', 'info');

                try {
                    // Call secured server-side RPC on Supabase
                    const { data, error } = await AppState.supabaseClient.rpc('export_full_backup');
                    if (error) throw error;

                    const jsonStr = JSON.stringify(data, null, 2);
                    const blob = new Blob([jsonStr], { type: 'application/json' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    const filename = 'AlAmira_Cloud_Backup_' + new Date().toISOString().slice(0, 10) + '_' + Date.now() + '.json';
                    a.href = url;
                    a.download = filename;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);

                    // Record metadata
                    await AppState.supabaseClient.from('backup_metadata').insert([{
                        filename,
                        records_count: {
                            products: (data.data.products || []).length,
                            invoices: (data.data.sales_invoices || []).length,
                            movements: (data.data.inventory_movements || []).length
                        },
                        notes: 'نسخة احتياطية يدوية كاملة',
                        created_by: AppState.currentUser.id
                    }]);

                    AppState.lastBackupTime = new Date().toISOString();
                    this.renderStatus();
                    App.checkBackupWarning();
                    showToast('تم استخراج وتحميل النسخة الاحتياطية الفعلية بنجاح (' + filename + ')', 'success');
                } catch (err) {
                    showToast('فشل إنشاء النسخة الاحتياطية: ' + (err.message || err), 'error');
                }
            },

            triggerRestoreFileDialog() {
                alert('تنبيه أمني وإرشادي:\n\nحفاظاً على سلامة البيانات وسجل الحركات الرقابي المعصوم من التعديل، تم تعطيل الاستعادة المباشرة من داخل المتصفح لأسباب أمنية.\n\nلإجراء استعادة شاملة لقاعدة البيانات، يجب تنفيذها بواسطة مسؤولي النظام عبر أدوات الخادم الرسمية (psql أو لوحة تحكم Supabase).\n\nخاصية تصدير النسخ الاحتياطية (JSON Export) تعمل بكفاءة تامة وتوفر سجلاً كاملاً للبيانات.');
            },

            handleFileSelected(e) {
                const file = e.target.files[0];
                if (!file) return;

                const reader = new FileReader();
                reader.onload = (event) => {
                    try {
                        const parsed = JSON.parse(event.target.result);
                        if (!parsed.schema_version || !parsed.data) {
                            throw new Error('الملف لا يحتوي على هيكلية نسخة احتياطية صالحة');
                        }
                        if (parsed.schema_version !== '1.0.0') {
                            throw new Error('إصدار المخطط (' + parsed.schema_version + ') غير متوافق مع النظام الحالي');
                        }

                        this.cachedRestoreData = parsed;
                        document.getElementById('restore-info-date').innerText = new Date(parsed.exported_at).toLocaleString('ar-EG');
                        document.getElementById('restore-info-version').innerText = parsed.schema_version;
                        document.getElementById('restore-info-products').innerText = (parsed.data.products || []).length;
                        document.getElementById('restore-info-invoices').innerText = (parsed.data.sales_invoices || []).length;
                        document.getElementById('restore-info-movements').innerText = (parsed.data.inventory_movements || []).length;
                        document.getElementById('restore-confirm-word').value = '';

                        document.getElementById('modal-restore-preview').classList.add('active');
                    } catch (err) {
                        showToast('فشل قراءة ملف النسخة الاحتياطية: ' + err.message, 'error');
                    }
                };
                reader.readAsText(file);
                e.target.value = '';
            },

            async confirmRestore() {
                if (!App.requireCloud()) return;

                const word = document.getElementById('restore-confirm-word').value.trim();
                if (word !== 'استعادة') {
                    showToast('يرجى كتابة كلمة "استعادة" بدقة لتأكيد العملية', 'warning');
                    return;
                }

                if (!this.cachedRestoreData) return;

                showToast('جاري تنفيذ الاستعادة الشاملة عبر الخادم الذري لـ Supabase...', 'info');

                try {
                    // Call secured server-side RPC to restore atomically
                    const { data, error } = await AppState.supabaseClient
                        .rpc('restore_full_backup', { p_backup: this.cachedRestoreData });

                    if (error) throw error;

                    this.cachedRestoreData = null;
                    App.closeModals();
                    showToast(data.message || 'تمت استعادة كافة البيانات السحابية بنجاح', 'success');
                    await App.fetchCloudData();
                } catch (err) {
                    showToast('فشل استعادة النسخة الاحتياطية: ' + (err.message || err), 'error');
                }
            }
        };

