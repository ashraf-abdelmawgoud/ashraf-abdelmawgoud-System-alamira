            addRow(selectedProdId = '') {
                const tbody = document.getElementById('invoice-items-tbody');
                const rowId = 'inv_row_' + Date.now() + Math.random().toString(36).substr(2, 4);
                const tr = document.createElement('tr');
                tr.id = rowId;

                let prodOptions = '<option value="">-- اختر الصنف من المخزن --</option>';
                if (AppState.products.length === 0) {
                    prodOptions += '<option value="" disabled>لا توجد أصناف مسجلة بالمخزن</option>';
                } else {
                    prodOptions += AppState.products.map(p => {
                        const stock = Number(p.current_stock || 0);
                        const allowsDec = Boolean(p.allows_decimal_quantity);
                        const stockText = stock <= 0 ? ' (رصيد المخزن: 0 - نفد)' : (' (المتاح: ' + formatQty(stock) + ' ' + (p.unit || '') + ')');
                        const isSelected = p.id === selectedProdId ? ' selected' : '';
                        return '<option value="' + p.id + '" data-sku="' + p.sku + '" data-name="' + p.name + '" data-unit="' + (p.unit || '') + '" data-price="' + (p.selling_price || 0) + '" data-stock="' + stock + '" data-allows-decimal="' + allowsDec + '"' + isSelected + '>' + p.sku + ' - ' + p.name + stockText + '</option>';
                    }).join('');
                }

                tr.innerHTML = '<td>' +
                        '<select class="form-control item-product" onchange="InvoicesModule.onProductChange(\'' + rowId + '\')">' + prodOptions + '</select>' +
