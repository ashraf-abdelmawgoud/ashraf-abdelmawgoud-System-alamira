                            <div class="kpi-sub">إذن صرف تشغيلي</div>
                        </div>
                        <div class="kpi-icon"><i class="fa-solid fa-truck-ramp-box"></i></div>
                    </div>
                </div>

                <!-- Quick Actions Bar -->
