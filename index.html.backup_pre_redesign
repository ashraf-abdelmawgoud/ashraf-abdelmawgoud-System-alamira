                    '<td><span class="badge badge-gray item-unit">--</span></td>' +
                    '<td>' +
                        '<input type="number" step="1" min="1" class="form-control item-qty" value="1" placeholder="1" oninput="InvoicesModule.recalculate()" required>' +
                        '<div class="item-qty-warning" style="font-size: 11px; color: var(--danger); font-weight: 700; margin-top: 2px; display: none;"></div>' +
                    '</td>' +
                    '<td><input type="number" step="0.01" min="0" class="form-control item-price" value="0.00" oninput="InvoicesModule.recalculate()" required></td>' +
                    '<td><strong class="item-gross">0.00</strong></td>' +
                    '<td><select class="form-control item-disc-type" onchange="InvoicesModule.recalculate()"><option value="none">بدون خصم</option><option value="percentage">نسبة مئوية (%)</option><option value="fixed">مبلغ ثابت (ج.م)</option></select></td>' +
                    '<td><input type="number" step="0.01" min="0" class="form-control item-disc-val" value="0" placeholder="0" oninput="InvoicesModule.recalculate()"></td>' +
                    '<td style="color: var(--danger);"><strong class="item-disc-amt">0.00</strong></td>' +
                    '<td><strong class="item-net" style="color: var(--navy-dark); font-size: 14px;">0.00 ج.م</strong></td>' +
                    '<td style="text-align: center;"><button type="button" class="btn btn-outline btn-sm" onclick="this.closest(\'tr\').remove(); InvoicesModule.recalculate();" style="color: var(--danger); padding: 4px 8px;" title="حذف البند"><i class="fa-solid fa-trash"></i></button></td>';

                tbody.appendChild(tr);
                this.onProductChange(rowId);
            },

            onProductChange(rowId) {
                const tr = document.getElementById(rowId);
                if (!tr) return;
                const select = tr.querySelector('.item-product');
                const selectedOpt = select ? select.options[select.selectedIndex] : null;
                const hintEl = tr.querySelector('.item-stock-hint');
                const qtyInput = tr.querySelector('.item-qty');

                if (!selectedOpt || !selectedOpt.value) {
                    tr.querySelector('.item-unit').innerText = '--';
                    tr.querySelector('.item-price').value = '0.00';
                    if (hintEl) hintEl.style.display = 'none';
                    this.recalculate();
                    return;
                }

                const unit = selectedOpt.getAttribute('data-unit') || '--';
                const price = Number(selectedOpt.getAttribute('data-price') || 0);
                const stock = Number(selectedOpt.getAttribute('data-stock') || 0);
                const allowsDec = selectedOpt.getAttribute('data-allows-decimal') === 'true';

                tr.querySelector('.item-unit').innerText = unit;
                tr.querySelector('.item-price').value = round2(price).toFixed(2);

                if (qtyInput) {
                    if (allowsDec) {
                        qtyInput.step = "0.001";
                        qtyInput.min = "0.001";
                        qtyInput.placeholder = "مثال: 1.5";
                    } else {
                        qtyInput.step = "1";
                        qtyInput.min = "1";
                        qtyInput.placeholder = "1";
                        if (qtyInput.value && Number(qtyInput.value) % 1 !== 0) {
                            qtyInput.value = Math.max(1, Math.round(Number(qtyInput.value)));
                        }
                    }
                }

                if (hintEl) {
                    if (stock <= 0) {
                        hintEl.style.display = 'block';
                        hintEl.innerHTML = '<span style="color: var(--danger); font-weight: 700;"><i class="fa-solid fa-circle-exclamation"></i> رصيد المخزن 0 (غير متوفر)</span>';
                    } else {
                        hintEl.style.display = 'block';
                        hintEl.innerHTML = '<span style="color: #059669; font-weight: 600;"><i class="fa-solid fa-box-open"></i> متاح بالمخزن: ' + formatQty(stock) + ' ' + unit + '</span>';
                    }
                }

                this.recalculate();
            },

            recalculate() {
                let grossTotal = 0;
                let itemDiscountsTotal = 0;
                let subtotal = 0;

                document.querySelectorAll('#invoice-items-tbody tr').forEach(tr => {
                    const select = tr.querySelector('.item-product');
                    const selectedOpt = select ? select.options[select.selectedIndex] : null;
                    const stock = selectedOpt && selectedOpt.value ? Number(selectedOpt.getAttribute('data-stock') || 0) : null;

                    const qtyInput = tr.querySelector('.item-qty');
                    const qty = Number(qtyInput.value) || 0;
                    const priceInput = tr.querySelector('.item-price');
                    const price = Number(priceInput.value) || 0;
                    const discType = tr.querySelector('.item-disc-type').value;
                    const discVal = Number(tr.querySelector('.item-disc-val').value) || 0;

                    // Warning if quantity exceeds available stock
                    const warnEl = tr.querySelector('.item-qty-warning');
                    if (warnEl) {
                        if (stock !== null && qty > stock) {
                            warnEl.style.display = 'block';
                            warnEl.innerText = 'يتجاوز المتاح (' + formatQty(stock) + ')';
                            qtyInput.style.borderColor = 'var(--danger)';
                        } else {
                            warnEl.style.display = 'none';
                            qtyInput.style.borderColor = '';
                        }
                    }

                    const lineGross = round2(qty * price);
                    let lineDiscAmt = 0;

                    if (discType === 'percentage') {
                        const pct = Math.min(Math.max(discVal, 0), 100);
                        lineDiscAmt = round2((lineGross * pct) / 100);
                    } else if (discType === 'fixed') {
                        lineDiscAmt = Math.min(Math.max(discVal, 0), lineGross);
                        lineDiscAmt = round2(lineDiscAmt);
                    }

                    const lineNet = round2(lineGross - lineDiscAmt);

                    tr.querySelector('.item-gross').innerText = lineGross.toFixed(2);
                    tr.querySelector('.item-disc-amt').innerText = lineDiscAmt > 0 ? ('-' + lineDiscAmt.toFixed(2)) : '0.00';
                    tr.querySelector('.item-net').innerText = lineNet.toFixed(2) + ' ج.م';

                    grossTotal = round2(grossTotal + lineGross);
                    itemDiscountsTotal = round2(itemDiscountsTotal + lineDiscAmt);
                    subtotal = round2(subtotal + lineNet);
                });

                const invDiscType = document.getElementById('inv-discount-type').value;
                const invDiscVal = Number(document.getElementById('inv-discount-val').value) || 0;
                let invDiscAmt = 0;

                if (invDiscType === 'percentage') {
                    const pct = Math.min(Math.max(invDiscVal, 0), 100);
                    invDiscAmt = round2((subtotal * pct) / 100);
                } else if (invDiscType === 'fixed') {
                    invDiscAmt = Math.min(Math.max(invDiscVal, 0), subtotal);
                    invDiscAmt = round2(invDiscAmt);
                }

                const charges = round2(Math.max(Number(document.getElementById('inv-charges').value) || 0, 0));
                const finalTotal = round2(subtotal - invDiscAmt + charges);

                document.getElementById('inv-calc-gross').innerText = grossTotal.toFixed(2) + ' ج.م';
                document.getElementById('inv-calc-item-discounts').innerText = '-' + itemDiscountsTotal.toFixed(2) + ' ج.م';
                document.getElementById('inv-calc-subtotal').innerText = subtotal.toFixed(2) + ' ج.م';
                document.getElementById('inv-calc-invoice-discount').innerText = '-' + invDiscAmt.toFixed(2) + ' ج.م';
                document.getElementById('inv-calc-charges').innerText = '+' + charges.toFixed(2) + ' ج.م';
                document.getElementById('inv-calc-final-total').innerText = finalTotal.toFixed(2) + ' ج.م';

                return {
                    grossTotal,
                    itemDiscountsTotal,
                    subtotal,
                    invDiscAmt,
                    charges,
                    finalTotal
                };
            },

            async handleSave(e) {
                if (e) e.preventDefault();
                if (!App.requireCloud()) return;

                const action = this.pendingAction || (e && e.submitter ? e.submitter.value : 'draft');
                this.pendingAction = null;

                const invoice_number = document.getElementById('inv-number').value;
                const invoice_date = document.getElementById('inv-date').value;
                const customer_id = document.getElementById('inv-customer').value;
                const customer_phone_snapshot = document.getElementById('inv-customer-phone').value.trim();
                const notes = document.getElementById('inv-notes').value.trim();

                // 1. Customer validation
                if (!customer_id) {
                    showToast('يرجى اختيار العميل أولاً لحفظ الفاتورة', 'warning');
                    document.getElementById('inv-customer').focus();
                    return;
                }

                // 2. Date validation
                if (!invoice_date) {
                    showToast('يرجى تحديد تاريخ الفاتورة', 'warning');
                    document.getElementById('inv-date').focus();
                    return;
                }

                const cust = AppState.customers.find(c => c.id === customer_id);
                const rows = document.querySelectorAll('#invoice-items-tbody tr');
                if (rows.length === 0) {
                    showToast('يجب إضافة صنف واحد على الأقل في الفاتورة', 'warning');
                    this.addRow();
                    return;
                }

                const items = [];
                for (let i = 0; i < rows.length; i++) {
                    const tr = rows[i];
                    const product_id = tr.querySelector('.item-product').value;
                    const quantity = Number(tr.querySelector('.item-qty').value);
                    const unit_price = Number(tr.querySelector('.item-price').value);
                    const discount_type = tr.querySelector('.item-disc-type').value;
                    const discount_value = Number(tr.querySelector('.item-disc-val').value) || 0;

                    if (!product_id) {
                        showToast('يرجى اختيار صنف محدد في البند رقم (' + (i + 1) + ')', 'warning');
                        tr.querySelector('.item-product').focus();
                        return;
                    }

                    if (isNaN(quantity) || quantity <= 0) {
                        showToast('الكمية يجب أن تكون أكبر من الصفر في البند رقم (' + (i + 1) + ')', 'warning');
                        tr.querySelector('.item-qty').focus();
                        return;
                    }

                    if (isNaN(unit_price) || unit_price < 0) {
                        showToast('سعر الوحدة لا يمكن أن يكون بالسالب في البند رقم (' + (i + 1) + ')', 'warning');
                        tr.querySelector('.item-price').focus();
                        return;
                    }

                    const prod = AppState.products.find(p => p.id === product_id);
                    if (prod && !prod.allows_decimal_quantity && (quantity % 1 !== 0)) {
                        showToast('الصنف "' + prod.name + '" يباع بالعدد الصحيح فقط ولا يقبل كميات كسرية (الكمية المطلوبة: ' + quantity + ')', 'warning');
                        tr.querySelector('.item-qty').focus();
                        return;
                    }

                    // Real stock check BEFORE touching the database if approving
                    if (action === 'approve') {
                        const availableStock = prod ? Number(prod.current_stock || 0) : 0;
                        if (quantity > availableStock) {
                            showToast('تعذر الاعتماد: رصيد الصنف "' + (prod ? prod.name : product_id) + '" في المخزن غير كافٍ لإتمام البيع (المتاح بالمخزن: ' + formatQty(availableStock) + '، المطلوب: ' + formatQty(quantity) + '). يمكنك حفظ الفاتورة كمسودة.', 'error');
                            tr.querySelector('.item-qty').focus();
                            return;
                        }
                    }

                    const lineGross = round2(quantity * unit_price);
                    let lineDiscAmt = 0;
                    if (discount_type === 'percentage') {
                        lineDiscAmt = round2((lineGross * Math.min(Math.max(discount_value, 0), 100)) / 100);
                    } else if (discount_type === 'fixed') {
                        lineDiscAmt = Math.min(Math.max(discount_value, 0), lineGross);
                        lineDiscAmt = round2(lineDiscAmt);
                    }
                    const lineNet = round2(lineGross - lineDiscAmt);

                    items.push({
                        product_id,
                        product_sku_snapshot: prod ? prod.sku : '',
                        product_name_snapshot: prod ? prod.name : '',
                        unit_snapshot: prod ? prod.unit : '',
                        quantity,
                        unit_price,
                        gross_amount: lineGross,
                        discount_type,
                        discount_value,
                        discount_amount: lineDiscAmt,
                        net_amount: lineNet
                    });
                }

                const calcs = this.recalculate();

                const btnDraft = document.getElementById('btn-inv-draft');
                const btnApprove = document.getElementById('btn-inv-approve');
                if (btnDraft) btnDraft.disabled = true;
                if (btnApprove) btnApprove.disabled = true;

                if (action === 'approve' && btnApprove) {
                    btnApprove.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> جاري الاعتماد والخصم...';
                } else if (btnDraft) {
                    btnDraft.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> جاري حفظ المسودة...';
                }

                try {
                    const { data: inv, error: invError } = await AppState.supabaseClient
                        .from('sales_invoices')
                        .insert([{
                            invoice_number,
                            invoice_date,
                            customer_id,
                            customer_name_snapshot: cust ? cust.name : '',
                            customer_phone_snapshot,
                            gross_amount: calcs.grossTotal,
                            item_discounts_amount: calcs.itemDiscountsTotal,
                            subtotal: calcs.subtotal,
                            invoice_discount_type: document.getElementById('inv-discount-type').value,
                            invoice_discount_value: Number(document.getElementById('inv-discount-val').value) || 0,
                            invoice_discount_amount: calcs.invDiscAmt,
                            additional_charges: calcs.charges,
                            final_total: calcs.finalTotal,
                            notes,
                            status: 'draft',
                            created_by: AppState.currentUser.id
                        }])
                        .select()
                        .single();

                    if (invError) throw invError;

                    const itemRows = items.map(it => ({
                        invoice_id: inv.id,
                        product_id: it.product_id,
                        product_sku_snapshot: it.product_sku_snapshot,
                        product_name_snapshot: it.product_name_snapshot,
                        unit_snapshot: it.unit_snapshot,
                        quantity: it.quantity,
                        unit_price: it.unit_price,
                        gross_amount: it.gross_amount,
                        discount_type: it.discount_type,
                        discount_value: it.discount_value,
                        discount_amount: it.discount_amount,
                        net_amount: it.net_amount
                    }));

                    const { error: itemsError } = await AppState.supabaseClient
                        .from('sales_invoice_items')
                        .insert(itemRows);

                    if (itemsError) throw itemsError;

                    App.closeModals();

                    if (action === 'approve') {
                        const { data: approveRes, error: approveErr } = await AppState.supabaseClient
                            .rpc('approve_sales_invoice', { p_invoice_id: inv.id });

                        if (approveErr) throw approveErr;

                        showToast(approveRes.message || ('تم اعتماد الفاتورة رقم ' + invoice_number + ' وخصم المخزون بنجاح'), 'success');
                        await App.fetchCloudData();

                        // Offer immediate printing
                        setTimeout(() => {
                            if (confirm('تم اعتماد فاتورة المبيعات رقم (' + invoice_number + ') وخصم الكميات من المخزون بنجاح.\n\nهل ترغب في طباعة الفاتورة الآن؟')) {
                                PrintModule.printSalesInvoice(inv.id);
                            }
                        }, 250);
                    } else {
                        showToast('تم حفظ مسودة الفاتورة رقم (' + invoice_number + ') بنجاح', 'success');
                        await App.fetchCloudData();
                    }
                } catch (err) {
                    showToast('فشل حفظ الفاتورة: ' + (err.message || err), 'error');
                } finally {
                    if (btnDraft) {
                        btnDraft.disabled = false;
                        btnDraft.innerHTML = '<i class="fa-regular fa-floppy-disk"></i> حفظ كمسودة';
                    }
                    if (btnApprove) {
                        btnApprove.disabled = false;
                        btnApprove.innerHTML = '<i class="fa-solid fa-check-double"></i> اعتماد الفاتورة وخصم المخزون';
                    }
                }
            },

            async approveInvoice(invoiceId) {
                if (!App.requireCloud()) return;
                try {
                    const { data, error } = await AppState.supabaseClient
                        .rpc('approve_sales_invoice', { p_invoice_id: invoiceId });

                    if (error) throw error;
                    showToast(data.message || 'تم اعتماد فاتورة المبيعات وخصم الكميات من المخزون بنجاح', 'success');
                    await App.fetchCloudData();

                    setTimeout(() => {
                        if (confirm('تم اعتماد الفاتورة بنجاح. هل ترغب في طباعتها الآن؟')) {
                            PrintModule.printSalesInvoice(invoiceId);
                        }
                    }, 250);
                } catch (err) {
                    showToast('فشل اعتماد الفاتورة: ' + (err.message || err), 'error');
                }
            },

            promptCancel(invoiceId) {
                document.getElementById('cancel-inv-id').value = invoiceId;
                document.getElementById('cancel-inv-reason').value = '';
                document.getElementById('modal-cancel-invoice').classList.add('active');
            },

            async executeCancel(e) {
                e.preventDefault();
                if (!App.requireCloud()) return;

                const invoiceId = document.getElementById('cancel-inv-id').value;
                const reason = document.getElementById('cancel-inv-reason').value.trim();

                try {
                    const { data, error } = await AppState.supabaseClient
                        .rpc('cancel_sales_invoice', { p_invoice_id: invoiceId, p_reason: reason });

                    if (error) throw error;
                    App.closeModals();
                    showToast(data.message || 'تم إلغاء الفاتورة واسترجاع المخزون بنجاح', 'success');
                    await App.fetchCloudData();
                } catch (err) {
                    showToast('فشل إلغاء الفاتورة: ' + (err.message || err), 'error');
                }
            }
        };

        /**
         * --------------------------------------------------------------------------
         * MODULE 6: INVENTORY ADJUSTMENTS (تسويات الجرد الفعلي)
         * --------------------------------------------------------------------------
         */
        const AdjustmentsModule = {
