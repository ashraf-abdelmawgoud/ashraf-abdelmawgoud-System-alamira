                document.getElementById('inv-discount-type').value = 'none';
                document.getElementById('inv-discount-val').value = '0.00';
                document.getElementById('inv-charges').value = '0.00';
                document.getElementById('inv-notes').value = '';
                document.getElementById('invoice-items-tbody').innerHTML = '';

