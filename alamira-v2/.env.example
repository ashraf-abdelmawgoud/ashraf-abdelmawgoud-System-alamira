# ==============================================================================
# AL-AMIRA ERP V2 — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT:
# 1. Never put production Supabase credentials or secret service keys in this file.
# 2. Never commit .env or .env.local to Git.
# ==============================================================================

# Application Branding & Metadata
VITE_APP_NAME="الأميرة للتوريدات العامة والتجارة"
VITE_APP_VERSION="2.0.0-staging"
VITE_APP_ENV="staging"

# ------------------------------------------------------------------------------
# MODE A: LOCAL DEVELOPMENT / MOCK SIMULATION (Default)
# ------------------------------------------------------------------------------
# Set to "true" to run completely in-memory without Supabase connection.
# VITE_ENABLE_MOCK_DATA="true"

# ------------------------------------------------------------------------------
# MODE B: ISOLATED STAGING ENVIRONMENT (Real Supabase Backend)
# ------------------------------------------------------------------------------
# Set to "false" to connect to an isolated staging Supabase instance.
# Replace with your dedicated STAGING project URL and anon public key.
# DO NOT USE THE PRODUCTION DATABASE URL: https://llmptlkvatndvrmnjiyj.supabase.co
# ------------------------------------------------------------------------------
VITE_ENABLE_MOCK_DATA="false"
VITE_SUPABASE_URL="https://your-staging-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-staging-anon-public-key"
